{
  "name": "@worlds/libsql",
  "private": true,
  "type": "module",
  "description": "Bun toolchain manifest for @worlds/libsql. The published package is described by jsr.json; scripts/check-manifests.ts keeps the two in sync.",
  "packageManager": "bun@1.4.5",
  "exports": {
    ".": "./src/mod.ts",
    "./quad-store": "./src/libsql/quad-store/mod.ts",
    "./search-index": "./src/libsql/search-index/mod.ts",
    "./rdfjs-store": "./src/libsql/rdfjs-store/mod.ts",
    "./schema": "./src/libsql/schema/libsql-schema-builder.ts"
  },
  "scripts": {
    "bench": "bun benchmarks/hybrid-search.bench.ts && bun benchmarks/idempotency-guard.bench.ts && bun benchmarks/index-maintenance.bench.ts && bun benchmarks/synchronization.bench.ts && bun benchmarks/sparql-perf-libsql.bench.ts",
    "bench:sparql-perf-libsql": "bun benchmarks/sparql-perf-libsql.bench.ts",
    "bench:sparql-perf-libsql:full-scan": "BENCH_HEXASTORE_PERF_FULL_SCAN=1 bun benchmarks/sparql-perf-libsql.bench.ts",
    "bench:sparql-perf-large-libsql": "bun benchmarks/sparql-perf-large-libsql.bench.ts",
    "bench:sparql-perf-large-libsql:full-scan": "BENCH_HEXASTORE_PERF_FULL_SCAN=1 bun benchmarks/sparql-perf-large-libsql.bench.ts",
    "bench:sparql-perf-large-libsql:reuse": "BENCH_REUSE_DB=1 bun benchmarks/sparql-perf-large-libsql.bench.ts",
    "check": "bun check --no-script",
    "check:manifests": "bun scripts/check-manifests.ts",
    "ci": "bun run fmt:check && bun run lint && bun run check && bun run check:manifests && bun run test",
    "example:libsql-hello-world": "bun examples/libsql-hello-world/main.ts",
    "fmt": "bun fmt --no-script",
    "fmt:check": "bun fmt --no-script --check",
    "lint": "oxlint --deny-warnings",
    "publish:dry": "jsr publish --dry-run --allow-dirty",
    "test": "bun test --timeout 120000"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@langchain/core": "^1.1.48",
    "@langchain/textsplitters": "^1.0.1",
    "@libsql/client": "^0.17.4",
    "@rdfjs/types": "^2.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@types/n3": "1.26.1",
    "@wazoo/sparql-engine": "npm:@jsr/wazoo__sparql-engine@^0.5.1",
    "@worlds/sdk": "npm:@jsr/worlds__sdk@^0.11.0",
    "@worlds/sqlite": "npm:@jsr/worlds__sqlite@^0.8.1",
    "ai": "^6.0.195",
    "n3": "^2.0.3",
    "rdf-canonize": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsr": "0.14.3",
    "mitata": "1.0.34",
    "oxlint": "1.94.0"
  }
}
