{
  "name": "@worlds/libsql",
  "version": "0.6.0",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./src/mod.ts",
    "./quad-store": "./src/libsql/quad-store/mod.ts",
    "./search-index": "./src/libsql/search-index/mod.ts",
    "./rdfjs-store": "./src/libsql/rdfjs-store/mod.ts",
    "./schema": "./src/libsql/schema/libsql-schema-builder.ts"
  },
  "imports": {
    "@/": "./src/",
    "ai": "npm:ai@^6.0.195",
    "@ai-sdk/google": "npm:@ai-sdk/google@^3.0.80",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@wazoo/sparql-engine": "jsr:@wazoo/sparql-engine@^0.4.1",
    "@worlds/sqlite": "jsr:@worlds/sqlite@^0.6.0",
    "@libsql/client": "npm:@libsql/client@^0.17.4",
    "@worlds/sdk": "jsr:@worlds/sdk@^0.6.0",
    "@worlds/sdk/quad-store": "jsr:@worlds/sdk@^0.6.0/quad-store",
    "@worlds/sdk/search-index": "jsr:@worlds/sdk@^0.6.0/search-index",
    "@worlds/sdk/search-index/embedding-service": "jsr:@worlds/sdk@^0.6.0/search-index/embedding-service",
    "@worlds/sdk/search-index/quad-chunker": "jsr:@worlds/sdk@^0.6.0/search-index/quad-chunker",
    "@worlds/sdk/testing": "jsr:@worlds/sdk@^0.6.0/testing",
    "@worlds/sdk/memory": "jsr:@worlds/sdk@^0.6.0/memory",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/async": "jsr:@std/async@^1.4.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.5",
    "@tensorflow/tfjs": "npm:@tensorflow/tfjs@^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "npm:@tensorflow/tfjs-backend-wasm@^4.22.0",
    "@types/n3": "npm:@types/n3@1.26.1",
    "n3": "npm:n3@^2.0.3",
    "rdf-canonize": "npm:rdf-canonize@^5.0.0",
    "@langchain/core": "npm:@langchain/core@^1.1.48",
    "@langchain/textsplitters": "npm:@langchain/textsplitters@^1.0.1",
    "zod": "npm:zod@^4.4.3"
  },
  "minimumDependencyAge": 0,
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check",
    "test": "deno test --allow-all",
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "ci": {
      "description": "Formats, lints, checks, and tests the code",
      "dependencies": [
        "fmt:check",
        "lint",
        "check",
        "test"
      ]
    },
    "example:libsql-hello-world": "deno run -A examples/libsql-hello-world/main.ts",
    "bench": "deno bench --allow-all benchmarks/",
    "bench:sparql-perf-libsql": "deno bench --allow-all benchmarks/sparql-perf-libsql.bench.ts",
    "bench:sparql-perf-libsql:full-scan": "deno bench --allow-all --env BENCH_HEXASTORE_PERF_FULL_SCAN=1 benchmarks/sparql-perf-libsql.bench.ts",
    "bench:sparql-perf-large-libsql": "deno bench --allow-all --v8-flags=--max-old-space-size=8192 benchmarks/sparql-perf-large-libsql.bench.ts",
    "bench:sparql-perf-large-libsql:full-scan": "deno bench --allow-all --env BENCH_HEXASTORE_PERF_FULL_SCAN=1 --v8-flags=--max-old-space-size=8192 benchmarks/sparql-perf-large-libsql.bench.ts",
    "bench:sparql-perf-large-libsql:reuse": "deno bench --allow-all --env BENCH_REUSE_DB=1 --v8-flags=--max-old-space-size=8192 benchmarks/sparql-perf-large-libsql.bench.ts"
  }
}
